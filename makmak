local POSITION_1 = Vector3.new(-4914.52100, 41295.43359, -3705.13477)
local POSITION_3 = Vector3.new(-4968.01562, 41281.78906, -3650.59204)

local TWEEN_SPEED = 80
local NEXT_EGG_WAIT_TIME = 15
local TOP_WAIT_TIME = 10

local SYSTEM_ENABLED = true
local AUTO_LM = true

local VOLCANO_RADIUS = 10
local VOLCANO_FIRE_COOLDOWN = 1

local busy = false
local recovering = false
local lastVolcanoFire = 0

local PRIORITY_LIST = {
	"volcanic",
	"cherub",
	"solaris",
	"blackhole"
}

local function notify(message)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "EGG SYSTEM",
			Text = message,
			Duration = 3
		})
	end)
end

local function normalizeName(name)
	return tostring(name or "")
		:lower()
		:gsub("%s+", " ")
		:gsub("^%s+", "")
		:gsub("%s+$", "")
end

local function getRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPosition(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		if object.PrimaryPart then
			return object.PrimaryPart.Position
		end

		local success, pivot = pcall(function()
			return object:GetPivot()
		end)

		if success then
			return pivot.Position
		end
	end

	local part = object:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position
end

local function matchesKeyword(egg, keyword)
	return normalizeName(egg.Name):find(
		normalizeName(keyword),
		1,
		true
	) ~= nil
end

local function teleportToPosition(position)
	local root = getRoot()

	if not root then
		return false
	end

	root.CFrame = CFrame.new(position)
	return true
end

local function tweenToPosition(position)
	if not SYSTEM_ENABLED then
		return false
	end

	local root = getRoot()

	if not root then
		return false
	end

	local distance = (root.Position - position).Magnitude

	if distance <= 1 then
		return true
	end

	local tween = TweenService:Create(
		root,
		TweenInfo.new(
			distance / TWEEN_SPEED,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = CFrame.new(position)
		}
	)

	tween:Play()
	tween.Completed:Wait()

	return SYSTEM_ENABLED and root.Parent ~= nil
end

local function teleportToVolcanoTop()
	local volcano = workspace:FindFirstChild("Volcano")
	local target = volcano and volcano:FindFirstChild("VolcanoTop")
	local root = getRoot()

	if not target or not root then
		return false
	end

	if target:IsA("BasePart") then
		root.CFrame = target.CFrame + Vector3.new(0, 5, 0)
	else
		root.CFrame = target:GetPivot() + Vector3.new(0, 5, 0)
	end

	return true
end

local function getVolcanoTopPosition()
	local volcano = workspace:FindFirstChild("Volcano")
	local target = volcano and volcano:FindFirstChild("VolcanoTop")

	if not target then
		return nil
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Model") then
		return target:GetPivot().Position
	end

	return nil
end

local function teleportToOwnPlot()
	local plots = workspace:FindFirstChild("Plots")

	if not plots then
		return false
	end

	for _, plot in ipairs(plots:GetChildren()) do
		local data = plot:FindFirstChild("Data")
		local owner = data and data:FindFirstChild("Owner")

		if owner then
			local isMine = false

			if owner:IsA("ObjectValue") then
				isMine = owner.Value == player
			elseif owner:IsA("StringValue") then
				isMine =
					owner.Value == player.Name
					or owner.Value == player.DisplayName
			elseif owner:IsA("IntValue")
				or owner:IsA("NumberValue") then
				isMine = owner.Value == player.UserId
			end

			if isMine then
				local root = getRoot()

				if root then
					root.CFrame =
						plot:GetPivot()
						+ Vector3.new(0, 5, 0)

					return true
				end
			end
		end
	end

	return false
end

local function findPriorityEgg()
	for _, priority in ipairs(PRIORITY_LIST) do
		for _, egg in ipairs(EggsFolder:GetChildren()) do
			if matchesKeyword(egg, priority) then
				return egg, priority
			end
		end
	end

	return nil, nil
end

local function waitForEggToDisappear(egg)
	while SYSTEM_ENABLED and egg and egg.Parent do
		task.wait(0.5)
	end

	return egg and not egg.Parent
end

local function processVolcanic(egg)
	if not egg or not egg.Parent then
		return
	end

	teleportToPosition(POSITION_1)
	task.wait(0.2)

	if not egg.Parent then
		teleportToOwnPlot()
		return
	end

	if not tweenToPosition(POSITION_3) then
		return
	end

	task.wait(0.1)

	if not egg.Parent then
		teleportToOwnPlot()
		return
	end

	local position = getPosition(egg)

	if not position then
		teleportToOwnPlot()
		return
	end

	teleportToPosition(position)

	notify("At volcanic egg - waiting for disappearance")

	local disappeared = waitForEggToDisappear(egg)

	if not SYSTEM_ENABLED then
		return
	end

	if not disappeared then
		teleportToOwnPlot()
		return
	end

	if AUTO_LM then
		notify("Volcanic egg disappeared - going VolcanoTop")

		if teleportToVolcanoTop() then
			task.wait(TOP_WAIT_TIME)
		end
	end

	teleportToOwnPlot()
end

local function processNormal(egg)
	if not egg or not egg.Parent then
		return
	end

	local position = getPosition(egg)

	if not position then
		teleportToOwnPlot()
		return
	end

	teleportToPosition(position)

	notify("At egg - waiting for disappearance")

	local disappeared = waitForEggToDisappear(egg)

	if not SYSTEM_ENABLED then
		return
	end

	if not disappeared then
		teleportToOwnPlot()
		return
	end

	if AUTO_LM then
		notify("Egg disappeared - going VolcanoTop")

		if teleportToVolcanoTop() then
			task.wait(TOP_WAIT_TIME)
		end
	end

	teleportToOwnPlot()
end

local function addPriority(keyword)
	keyword = normalizeName(keyword)

	if keyword == "" then
		return
	end

	for index, existing in ipairs(PRIORITY_LIST) do
		if normalizeName(existing) == keyword then
			table.remove(PRIORITY_LIST, index)
			break
		end
	end

	table.insert(PRIORITY_LIST, keyword)
	notify("Priority added: " .. keyword)
end

local function removePriority(keyword)
	keyword = normalizeName(keyword)

	for index, existing in ipairs(PRIORITY_LIST) do
		if normalizeName(existing) == keyword then
			table.remove(PRIORITY_LIST, index)
			notify("Priority removed: " .. keyword)
			return
		end
	end
end

task.spawn(function()
	while true do
		if SYSTEM_ENABLED and not busy and not recovering then
			local egg, priority = findPriorityEgg()

			if egg then
				busy = true

				if priority == "volcanic" then
					processVolcanic(egg)
				else
					processNormal(egg)
				end

				if SYSTEM_ENABLED then
					task.wait(NEXT_EGG_WAIT_TIME)
				end

				busy = false
			else
				task.wait(1)
			end
		else
			task.wait(0.2)
		end
	end
end)

local function processCommand(message)
	message = normalizeName(message)

	if message == "*on" then
		SYSTEM_ENABLED = true
		recovering = false
		notify("System enabled")
		return
	end

	if message == "*off" then
		SYSTEM_ENABLED = false
		AUTO_LM = false
		recovering = false
		notify("System disabled")
		return
	end

	if message == "*auto lm" then
		AUTO_LM = true
		notify("Auto Lava Mutation: ON")
		return
	end

	if message == "*off auto lm" then
		AUTO_LM = false
		notify("Auto Lava Mutation: OFF")
		return
	end

	if message:sub(1, 6) == "*addp " then
		addPriority(message:sub(7))
		return
	end

	if message:sub(1, 6) == "*remp " then
		removePriority(message:sub(7))
		return
	end
end

pcall(function()
	TextChatService.MessageReceived:Connect(function(message)
		if message and message.Text then
			processCommand(message.Text)
		end
	end)
end)

