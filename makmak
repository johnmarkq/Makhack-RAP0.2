		if not SYSTEM_ENABLED or not AUTO_LM then
			return
		end

		local root = getRoot()
		local topPosition = getVolcanoTopPosition()

		if not root or not topPosition then
			return
		end

		local distance =
			(root.Position - topPosition).Magnitude

		if distance <= VOLCANO_RADIUS then
			local now = os.clock()

			if now - lastVolcanoFire >= VOLCANO_FIRE_COOLDOWN then
				volcanoEvent:FireServer()
				lastVolcanoFire = now
			end
		end
	end)
end

local RADIUS = 15
local HOLD_DURATION = 2
local REPEAT_COUNT = 3

local function findPrompt(egg)
	for _, obj in ipairs(egg:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			return obj
		end
	end

	return nil
end

local function collectEgg(egg, prompt)
	for i = 1, REPEAT_COUNT do
		if not egg.Parent or not prompt.Parent then
			break
		end

		local root = getRoot()

		if not root then
			break
		end

		local promptPart

		if prompt.Parent:IsA("BasePart") then
			promptPart = prompt.Parent
		else
			promptPart = prompt:FindFirstAncestorWhichIsA("BasePart")
		end

		if promptPart then
			local distance =
				(root.Position - promptPart.Position).Magnitude

			if distance <= RADIUS then
				fireproximityprompt(prompt, HOLD_DURATION)
			else
				break
			end
		end

		task.wait(0.1)
	end
end

task.spawn(function()
	while task.wait(0.1) do
		local root = getRoot()

		if root then
			for _, egg in ipairs(EggsFolder:GetChildren()) do
				local prompt = findPrompt(egg)

				if prompt then
					local targetPart

					if prompt.Parent:IsA("BasePart") then
						targetPart = prompt.Parent
					else
						targetPart =
							egg:IsA("BasePart")
							and egg
							or egg:FindFirstChildWhichIsA("BasePart", true)
					end

					if targetPart then
						local distance =
							(root.Position - targetPart.Position).Magnitude

						if distance <= RADIUS then
							task.spawn(
								collectEgg,
								egg,
								prompt
							)
						end
					end
				end
			end
		end
	end
end)

